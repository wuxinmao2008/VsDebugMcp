
<Project Sdk="Microsoft.VisualStudio.Sdk.Build">
  <PropertyGroup>
    <TargetFrameworks>vs2026_5</TargetFrameworks>
    <GeneratePkgDefFile>True</GeneratePkgDefFile>
    <DeployExtension>false</DeployExtension>
    <ExtensionType>VSSDK</ExtensionType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <VisualStudioSDKImplicitPackageVersion>17.14.40265</VisualStudioSDKImplicitPackageVersion>
    <HostProject>$(MSBuildProjectDirectory)\..\VsDebugMcp.Host\VsDebugMcp.Host.csproj</HostProject>
    <HostPublishDirectory>$(BaseIntermediateOutputPath)host\$(Configuration)\</HostPublishDirectory>
    <Platforms>AnyCPU;x64</Platforms>
    <IsPackable>false</IsPackable>
    <Version>0.1.7.0</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <VsixDeployOnDebug>true</VsixDeployOnDebug>
    <DebuggerFlavor>VsixDebugger</DebuggerFlavor>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DeployExtension>false</DeployExtension>
    <VsixDeployOnDebug>false</VsixDeployOnDebug>
    <DeployVSTemplates>false</DeployVSTemplates>
    <RegisterOutputPackage>false</RegisterOutputPackage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VsDebugMcp.Protocol\VsDebugMcp.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\logo.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>Assets</VSIXSubPath>
    </Content>
    <Content Include="..\..\assets\screenshot_01.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>assets</VSIXSubPath>
    </Content>
    <Content Include="..\..\CHANGELOG.md">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\..\Overview.md">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\..\LICENSE.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>
  <Target Name="PublishVsDebugMcpHost" BeforeTargets="GetVsixSourceItems">
    <Exec Command="dotnet publish &quot;$(HostProject)&quot; --configuration $(Configuration) --runtime win-x64 --self-contained false --output &quot;$(HostPublishDirectory)&quot;" />
    <ItemGroup>
      <Content Include="$(HostPublishDirectory)**\*" Exclude="$(HostPublishDirectory)**\*.pdb">
        <IncludeInVSIX>true</IncludeInVSIX>
        <VSIXSubPath>Host\%(RecursiveDir)</VSIXSubPath>
      </Content>
    </ItemGroup>
  </Target>
</Project>
